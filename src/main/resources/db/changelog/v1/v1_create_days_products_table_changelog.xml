<databaseChangeLog xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
   http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-3.4.xsd">

    <changeSet id="V1-days-products" author="KOLODEI S.V.">
        <preConditions onFail="MARK_RAN">
            <not>
                <tableExists tableName="days_products"/>
            </not>
        </preConditions>
        <createTable tableName="days_products">
            <column name="days_id" type="bigint">
                <constraints primaryKey="true"
                             foreignKeyName="days_id_fk"
                             referencedTableName="days"
                             referencedColumnNames="id"/>
            </column>
            <column name="products_id" type="bigint">
                <constraints foreignKeyName="products_id_fk"
                             referencedTableName="products"
                             referencedColumnNames="id"/>
            </column>
        </createTable>
    </changeSet>

</databaseChangeLog>