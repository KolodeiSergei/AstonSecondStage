<databaseChangeLog xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
   http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-3.4.xsd">

    <changeSet id="V1-day" author="KOLODEI S.V.">
        <preConditions onFail="MARK_RAN">
            <not>
                <tableExists tableName="days"/>
            </not>
        </preConditions>
        <createTable tableName="days">
            <column name="id" type="bigint">
                <constraints primaryKey="true"/>
            </column>
            <column name="day" type="integer">
                <constraints nullable="true"/>
            </column>
            <column name="pref_calories" type="float">
                <constraints nullable="true"/>
            </column>
            <column name="def_calories" type="float">
                <constraints nullable="true"/>
            </column>
            <column name="user_id" type="bigint">
                <constraints nullable="true"
                             foreignKeyName="user_id_fk"
                             referencedTableName="users"
                             referencedColumnNames="id"/>
            </column>
        </createTable>
    </changeSet>
</databaseChangeLog>